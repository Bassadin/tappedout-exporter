{
  "tasks": {
    "start": "deno run --allow-env --allow-net=tappedout.net --allow-read --allow-write src/main.ts",
    "once": "deno run --allow-env --allow-net=tappedout.net --allow-read --allow-write src/main.ts --once",
    "format": "deno fmt",
    "check": "deno fmt --check && deno lint && deno check src/main.ts && deno task coverage",
    "test": "deno test --allow-read=tests/fixtures",
    "coverage": "deno test --clean --allow-read=tests/fixtures --coverage=coverage && deno coverage coverage"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
