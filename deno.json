{
  "version": "0.2.1",
  "tasks": {
    "start": "deno run --allow-env --allow-net=tappedout.net --allow-read --allow-write src/main.ts",
    "once": "deno run --allow-env --allow-net=tappedout.net --allow-read --allow-write src/main.ts --once",
    "format": "deno fmt",
    "check": "deno fmt --check && deno lint && deno check src/main.ts && deno task coverage",
    "test": "deno test --allow-env --allow-read=tests --allow-write=tests",
    "coverage": "deno test --clean --allow-env --allow-read=tests --allow-write=tests --coverage=coverage && deno coverage coverage"
  },
  "fmt": {
    "exclude": [
      "CHANGELOG.md",
      ".release-please-manifest.json"
    ],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
